# Credenciais do usuário admin local
# Renomeie este arquivo para .env.local.seed para que o servidor (server/db.js -> seedAdmin)
# crie/verifique o usuário admin com estes valores.
# NÃO commite este arquivo no git (já está no .gitignore)
#
# Se este arquivo não existir, serão usados os valores padrão:
#   Email:  admin@portalguard.local
#   Senha:  portaguard@2024
#
# Para personalizar, preencha abaixo:

ADMIN_EMAIL=admin@portalguard.local
ADMIN_PASSWORD=portaguard@2024
ADMIN_NAME=Administrador
